<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= blog.title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <main class="max-w-3xl mx-auto p-6">
    <article class="bg-white rounded shadow p-6">
      <% if (blog.coverImageUrl) { %>
        <img src="<%= blog.coverImageUrl %>" alt="Cover" class="w-full h-60 object-cover rounded mb-4">
      <% } %>

      <h1 class="text-2xl font-bold mb-2"><%= blog.title %></h1>
      <div class="text-sm text-gray-600 mb-4">
        By <%= blog.createdBy && blog.createdBy.fullname ? blog.createdBy.fullname : 'Unknown' %>
        <% if (blog.createdAt) { %> · <%= new Date(blog.createdAt).toLocaleString() %><% } %>
      </div>

      <div class="prose max-w-none">
        <%= blog.content %>
      </div>
    </article>

      <!-- Comments -->
      <section class="mt-8">
        <h3 class="text-lg font-semibold mb-3">Comments</h3>

        <% if (comments && comments.length) { %>
          <ul class="space-y-4">
            <% comments.forEach(function(c){ %>
              <li class="border rounded p-3 bg-white">
                <div class="text-sm text-gray-700"><%= c.content %></div>
                <div class="text-xs text-gray-500 mt-2">By <%= c.createdBy && c.createdBy.fullname ? c.createdBy.fullname : 'Unknown' %> · <%= new Date(c.createdAt).toLocaleString() %></div>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="text-gray-600">No comments yet. Be the first to comment!</p>
        <% } %>

        <!-- Comment form (only show when logged in) -->
        <% if (user) { %>
          <form action="/blogs/comment/<%= blog._id %>" method="POST" class="mt-4">
            <label for="content" class="block text-sm font-medium text-gray-700 mb-1">Add a comment</label>
            <textarea id="content" name="content" rows="3" required class="w-full px-3 py-2 border border-gray-300 rounded-md"></textarea>
            <div class="mt-2">
              <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-md">Post comment</button>
            </div>
          </form>
        <% } else { %>
          <p class="mt-4">Please <a href="/user/signin" class="text-blue-600">sign in</a> to add a comment.</p>
        <% } %>
      </section>

    <div class="mt-6">
      <a href="/" class="text-blue-600">← Back to homepage</a>
    </div>
  </main>
</body>
</html>
