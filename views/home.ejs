<!DOCTYPE html>
<html lang="en">
<head>
    <title>Homepage</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('../partials/nav.ejs') %>
    <main class="max-w-6xl mx-auto p-6">
        <h1 class="text-2xl font-bold mb-4">Homepage</h1>

        <% if (blgs && blgs.length) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <% blgs.forEach(function(blog){ %>
                    <article class="bg-white shadow rounded-lg p-4">
                        <h2 class="text-lg font-semibold mb-2"><a href="/blogs/<%= blog._id %>" class="hover:underline"><%= blog.title %></a></h2>
                        <p class="text-sm text-gray-600 mb-3"><%= (blog.content || '').slice(0, 200) %><%= blog.content && blog.content.length > 200 ? '...' : '' %></p>
                        <div class="text-xs text-gray-500">
                            By <%= blog.createdBy && blog.createdBy.fullname ? blog.createdBy.fullname : 'Unknown' %>
                            <% if (blog.createdAt) { %> · <%= new Date(blog.createdAt).toLocaleString() %><% } %>
                        </div>
                        <a href="/blogs/<%= blog._id %>">view</a>
                    </article>
                <% }) %>
            </div>
        <% } else { %>
            <p class="text-gray-600">No blogs yet. Be the first to <a href="/blogs/add-new" class="text-blue-600">create one</a>.</p>
        <% } %>
    </main>
</body>
</html>